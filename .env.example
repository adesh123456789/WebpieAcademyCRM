# =============================================================
# WebPie Academic OS - Production Environment Configuration
# PRD v2.0 Section 39 & 40
# =============================================================

# Server Port and Host
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

# Database Connection (PostgreSQL 18 production / SQLite dev fallback)
DATABASE_URL="file:./dev.db"
# For PostgreSQL production:
# DATABASE_URL="postgresql://webpie_admin:WebPieSecure2026@localhost:5432/webpie_academic_os?schema=public"

# Redis Cache & Background Queue
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="webpie-academic-os-super-secret-production-jwt-key-2026"

# Public Application Metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="WebPie Academic Intelligence OS"
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# AI Gateway Keys (Google Gemini API & OpenAI)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Academic Node Fleet Secret
NODE_ENCRYPTION_KEY="webpie_node_fleet_aes_256_secret_key"
