# =============================================================
# WebPie Academic OS - environment template
# Copy to .env for local dev; inject real values from a secret
# manager in staging/production. Never commit a filled-in .env.
# PRD v2.0 Sections 39 & 41 (SEC-006: secrets via env/secret manager)
# =============================================================

# --- Server ---
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production

# --- Database ---
# Local / offline Academic Node dev: SQLite (zero dependencies).
DATABASE_URL="file:./dev.db"
# Cloud production: PostgreSQL. Provide via secret manager, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/webpie_academic_os?schema=public"

# Used only by docker-compose to provision the bundled postgres service.
# Set these in your shell or an untracked .env before `docker compose up`.
POSTGRES_USER=webpie_admin
POSTGRES_PASSWORD=
POSTGRES_DB=webpie_academic_os

# --- Cache / queue ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# Generate a fresh 256-bit secret per environment:  openssl rand -base64 32
JWT_SECRET=

# --- Public app metadata (exposed to the browser) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="WebPie Academic Intelligence OS"
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# --- AI Gateway (optional) ---
# Leave empty to run deterministic bank-only fallbacks (no external model calls).
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# --- Academic Node fleet ---
# Generate per deployment:  openssl rand -hex 32
NODE_ENCRYPTION_KEY=
# Config for the Academic Node PROCESS itself (npm run node:start) - not read
# by the cloud app. NODE_ENCRYPTION_KEY above is required by both.
NODE_PORT=4173
NODE_DATA_DIR=./node-data
NODE_CLOUD_BASE_URL="http://localhost:3000"
NODE_SYNC_INTERVAL_MS=60000

# --- Storage ---
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
